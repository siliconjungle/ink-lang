module WebProof26;
pub fn invariant_fold_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs,seed,fn(x)=>fn(a)=>choose(seed<k,choose(a<seed,x+a*k,x-a),choose(a>k,a-x*seed,a+x)));}
pub fn invariant_fold_heldout_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs,seed,fn(x)=>fn(a)=>choose(seed<k,choose(x<seed,a*k+x,a-x),choose(a<k,x*k+a,x-a*seed)));}
pub fn accepted_repair_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.filter(fn(x)=>rem_or(x,seed,0)<k).map(fn(x)=>choose(rem_or(x,seed,0)<k,choose(x<seed,seed-x,x+seed),choose(x>seed,x-seed,x*k)));}
pub fn accepted_checksum_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>rem_or(x,seed,0)<k).map(fn(x)=>choose(rem_or(x,seed,0)<k,choose(x<seed,seed-x,x+seed),choose(x>seed,x-seed,x*k))),seed,fn(x)=>fn(a)=>choose(a<seed,x+a*k,x-a));}
pub fn paired_calibrated_u32(xs:List<u32>,ys:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(ys,fn(a)=>fn(b)=>choose(a<seed,a+b*k,a-b*k)).map(fn(v)=>choose(v>k,v-seed,v+seed));}
pub fn skip_first_accepted_u32(xs:List<u32>,seed:u32,k:u32)->u32{return xs.filter(fn(x)=>x>seed).at_or(0,seed);}
pub fn paired_ordered_score_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.zip(xs,fn(a)=>fn(b)=>choose(a<seed,a+b*k,a-b*k)),seed,fn(v)=>fn(acc)=>choose(acc<seed,v-acc,v+acc*k));}
pub fn reference_indexed_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,2,0)==0,x+k,x-seed));}
pub fn reference_modular_mix_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>modular_mix_word(x,seed,k));}
fn modular_mix_word(x:u32,seed:u32,k:u32)->u32{let v0:u32=x+seed;let v1:u32=rem_or(v0*(k+1)+x,4294967291,seed);let v2:u32=rem_or(v1*(k+3)+x,4294967291,seed);let v3:u32=rem_or(v2*(k+5)+x,4294967291,seed);let v4:u32=rem_or(v3*(k+7)+x,4294967291,seed);let v5:u32=rem_or(v4*(k+9)+x,4294967291,seed);let v6:u32=rem_or(v5*(k+11)+x,4294967291,seed);let v7:u32=rem_or(v6*(k+13)+x,4294967291,seed);let v8:u32=rem_or(v7*(k+15)+x,4294967291,seed);let v9:u32=rem_or(v8*(k+17)+x,4294967291,seed);let v10:u32=rem_or(v9*(k+19)+x,4294967291,seed);let v11:u32=rem_or(v10*(k+21)+x,4294967291,seed);let v12:u32=rem_or(v11*(k+23)+x,4294967291,seed);let v13:u32=rem_or(v12*(k+25)+x,4294967291,seed);let v14:u32=rem_or(v13*(k+27)+x,4294967291,seed);let v15:u32=rem_or(v14*(k+29)+x,4294967291,seed);let v16:u32=rem_or(v15*(k+31)+x,4294967291,seed);return v16;}
