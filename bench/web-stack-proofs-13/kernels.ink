module WebProof13;
pub fn mixed_prefix6(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>(((1+(x+(x*x)))+(((x*x)*x)+(((x*x)*(x*x))+(((x*x)*(x*x))*x)))))*k+seed);}
pub fn mixed_prefix12(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>((((1+(x+(x*x)))+(((x*x)*x)+(((x*x)*(x*x))+(((x*x)*(x*x))*x))))+(((((x*x)*x)*((x*x)*x))+(((((x*x)*x)*((x*x)*x))*x)+(((x*x)*(x*x))*((x*x)*(x*x)))))+(((((x*x)*(x*x))*((x*x)*(x*x)))*x)+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x))))))*k+seed);}
pub fn mixed_prefix24(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>(((((1+(x+(x*x)))+(((x*x)*x)+(((x*x)*(x*x))+(((x*x)*(x*x))*x))))+(((((x*x)*x)*((x*x)*x))+(((((x*x)*x)*((x*x)*x))*x)+(((x*x)*(x*x))*((x*x)*(x*x)))))+(((((x*x)*(x*x))*((x*x)*(x*x)))*x)+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)))))+(((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))+((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x)+(((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))))+(((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x)+(((((x*x)*(x*x))*((x*x)*(x*x)))*(((x*x)*(x*x))*((x*x)*(x*x))))+(((((x*x)*(x*x))*((x*x)*(x*x)))*(((x*x)*(x*x))*((x*x)*(x*x))))*x))))+(((((((x*x)*(x*x))*((x*x)*(x*x)))*x)*((((x*x)*(x*x))*((x*x)*(x*x)))*x))+(((((((x*x)*(x*x))*((x*x)*(x*x)))*x)*((((x*x)*(x*x))*((x*x)*(x*x)))*x))*x)+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x)))))+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x)))*x)+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)*(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x))+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)*(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x))*x)))))))*k+seed);}

pub fn value_gated_left(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>x-seed).zip(xs.map(fn(x)=>x*x+k),fn(a)=>fn(b)=>choose(a<seed,a,b)).map(fn(x)=>x*k+seed);}
pub fn value_gated_right(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>x*x+k).zip(xs.map(fn(x)=>x-seed),fn(a)=>fn(b)=>choose(b<seed,a,b)).map(fn(x)=>x*k+seed);}
pub fn nested_gated_route(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(xs,fn(a)=>fn(b)=>a+b*k).zip(xs,fn(a)=>fn(b)=>choose(b<seed,a,b)).map(fn(x)=>x+seed);}
