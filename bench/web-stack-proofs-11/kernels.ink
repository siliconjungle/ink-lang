pub fn geometric_prefix32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>((((((1+x)+((x*x)+((x*x)*x)))+((((x*x)*(x*x))+(((x*x)*(x*x))*x))+((((x*x)*x)*((x*x)*x))+((((x*x)*x)*((x*x)*x))*x))))+((((((x*x)*(x*x))*((x*x)*(x*x)))+((((x*x)*(x*x))*((x*x)*(x*x)))*x))+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))+(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)))+((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))+(((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x))+((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))+((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x)))))+((((((((x*x)*(x*x))*((x*x)*(x*x)))*(((x*x)*(x*x))*((x*x)*(x*x))))+(((((x*x)*(x*x))*((x*x)*(x*x)))*(((x*x)*(x*x))*((x*x)*(x*x))))*x))+((((((x*x)*(x*x))*((x*x)*(x*x)))*x)*((((x*x)*(x*x))*((x*x)*(x*x)))*x))+((((((x*x)*(x*x))*((x*x)*(x*x)))*x)*((((x*x)*(x*x))*((x*x)*(x*x)))*x))*x)))+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x)))+((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x)))*x))+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)*(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x))+(((((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x)*(((((x*x)*(x*x))*x)*(((x*x)*(x*x))*x))*x))*x))))+((((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x))))+((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x))))*x))+(((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x)*(((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x))+(((((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x)*(((((x*x)*x)*((x*x)*x))*(((x*x)*x)*((x*x)*x)))*x))*x)))+((((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*(((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x)))+(((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*(((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x)))*x))+((((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x)*((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x))+((((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x)*((((((x*x)*x)*((x*x)*x))*x)*((((x*x)*x)*((x*x)*x))*x))*x))*x)))))))*k+seed);}

pub fn bounded_right_prefix(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(xs.concat(xs),fn(a)=>fn(b)=>a+b).map(fn(x)=>choose(x<seed,x*k,x+seed));}
pub fn bounded_mapped_right(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(xs.map(fn(x)=>x*x+seed).concat(xs),fn(a)=>fn(b)=>a-b*k).map(fn(x)=>x+seed);}
pub fn bounded_mapped_product(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.concat(xs).zip(xs.map(fn(x)=>x*k+seed),fn(a)=>fn(b)=>a*b).map(fn(x)=>x+seed);}
