module WebProof11;
pub fn geometric_prefix8(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map(fn(x)=>((((1+x)+((x*x)+((x*x)*x)))+((((x*x)*(x*x))+(((x*x)*(x*x))*x))+((((x*x)*x)*((x*x)*x))+((((x*x)*x)*((x*x)*x))*x)))))*k+seed);}
