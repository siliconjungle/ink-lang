module WebProof22;
pub fn guard_complement_add_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x+seed,k,k)<seed,quot_or(x*k+seed,seed,k),0)+choose((quot_or(x+seed,k,k)<seed)==false,choose(x<k,k-x,x-k)+seed,0)));}
pub fn guard_complement_subtract_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x+seed,k,k)<seed,quot_or(x*k+seed,seed,k),0)-choose((quot_or(x+seed,k,k)<seed)==false,choose(x<k,k-x,x-k)+seed,0)));}
pub fn guard_same_choice_add_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x+seed,k,k)<seed,quot_or(x*k+seed,seed,k),choose(x<k,k-x,x-k)+seed)+choose(quot_or(x+seed,k,k)<seed,x+seed,quot_or(x+seed,k,seed))));}
pub fn guard_complement_add_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x*k+seed,seed,k)>k,choose(x>seed,x-seed,seed-x)*3,0)+choose((quot_or(x*k+seed,seed,k)>k)==false,quot_or(x+seed,k,seed),0)));}
pub fn guard_complement_subtract_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x*k+seed,seed,k)>k,choose(x>seed,x-seed,seed-x)*3,0)-choose((quot_or(x*k+seed,seed,k)>k)==false,quot_or(x+seed,k,seed),0)));}
pub fn guard_same_choice_add_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(quot_or(x*k+seed,seed,k)>k,choose(x>seed,x-seed,seed-x)*3,quot_or(x+seed,k,seed))+choose(quot_or(x*k+seed,seed,k)>k,quot_or(x*k,k,seed),x+k)));}
pub fn indexed_both_zip_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,2,0)==0,x+k,x-seed)).zip(xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,3,0)==0,x*3+k,x+seed)),fn(a)=>fn(b)=>choose(a<b,a+b*k,a-b*k));}
pub fn indexed_left_zip_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,2,0)==0,x+k,x-seed)).zip(xs,fn(a)=>fn(b)=>choose(a<b,a+b*k,a-b*k));}
pub fn indexed_right_zip_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,3,0)==0,x*3+k,x+seed)),fn(a)=>fn(b)=>choose(a<b,a+b*k,a-b*k));}
pub fn indexed_both_zip_heldout_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,3,0)==0,choose(x>k,x,seed),x+k)).zip(xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,2,0)==0,seed-x,x*3)),fn(a)=>fn(b)=>choose(a>b,a*b+seed,a+b*k));}
pub fn indexed_left_zip_heldout_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,3,0)==0,choose(x>k,x,seed),x+k)).zip(xs,fn(a)=>fn(b)=>choose(a>b,a*b+seed,a+b*k));}
pub fn indexed_right_zip_heldout_u32(xs:List<u32>,seed:u32,k:u32)->List<u32>{return xs.zip(xs.map_indexed(fn(i)=>fn(x)=>choose(rem_or(i,2,0)==0,seed-x,x*3)),fn(a)=>fn(b)=>choose(a>b,a*b+seed,a+b*k));}
