module WholeLearning;
record Block{w0:f32,w1:f32,w2:f32,w3:f32,w4:f32,w5:f32,w6:f32,w7:f32,}
record Weights{b0:Block,b1:Block,b2:Block,b3:Block,b4:Block,b5:Block,b6:Block,b7:Block,}
fn block(w:Block)->f32{return w.w0*w.w0+w.w1*w.w1+w.w2*w.w2+w.w3*w.w3+w.w4*w.w4+w.w5*w.w5+w.w6*w.w6+w.w7*w.w7;}
fn energy(w:Weights,target:f32)->f32{let error=block(w.b0)+block(w.b1)+block(w.b2)+block(w.b3)+block(w.b4)+block(w.b5)+block(w.b6)+block(w.b7)-target;return error*error;}
fn derivatives(w:Weights,target:f32,maximum:u32,stop:Bool)->Result<Weights,String>{return reverse_gradient(energy,w,maximum,stop,target);}
fn linearized(w:Weights,target:f32,maximum:u32,stop:Bool)->Result<f32,String>{return reverse_linearize(energy,w,maximum,stop,target).map(fn(r)=>r.value);}
fn update(w:Weights,g:Weights,rate:f32)->Weights{return Weights{b0:Block{w0:w.b0.w0-rate*g.b0.w0,w1:w.b0.w1-rate*g.b0.w1,w2:w.b0.w2-rate*g.b0.w2,w3:w.b0.w3-rate*g.b0.w3,w4:w.b0.w4-rate*g.b0.w4,w5:w.b0.w5-rate*g.b0.w5,w6:w.b0.w6-rate*g.b0.w6,w7:w.b0.w7-rate*g.b0.w7},b1:Block{w0:w.b1.w0-rate*g.b1.w0,w1:w.b1.w1-rate*g.b1.w1,w2:w.b1.w2-rate*g.b1.w2,w3:w.b1.w3-rate*g.b1.w3,w4:w.b1.w4-rate*g.b1.w4,w5:w.b1.w5-rate*g.b1.w5,w6:w.b1.w6-rate*g.b1.w6,w7:w.b1.w7-rate*g.b1.w7},b2:Block{w0:w.b2.w0-rate*g.b2.w0,w1:w.b2.w1-rate*g.b2.w1,w2:w.b2.w2-rate*g.b2.w2,w3:w.b2.w3-rate*g.b2.w3,w4:w.b2.w4-rate*g.b2.w4,w5:w.b2.w5-rate*g.b2.w5,w6:w.b2.w6-rate*g.b2.w6,w7:w.b2.w7-rate*g.b2.w7},b3:Block{w0:w.b3.w0-rate*g.b3.w0,w1:w.b3.w1-rate*g.b3.w1,w2:w.b3.w2-rate*g.b3.w2,w3:w.b3.w3-rate*g.b3.w3,w4:w.b3.w4-rate*g.b3.w4,w5:w.b3.w5-rate*g.b3.w5,w6:w.b3.w6-rate*g.b3.w6,w7:w.b3.w7-rate*g.b3.w7},b4:Block{w0:w.b4.w0-rate*g.b4.w0,w1:w.b4.w1-rate*g.b4.w1,w2:w.b4.w2-rate*g.b4.w2,w3:w.b4.w3-rate*g.b4.w3,w4:w.b4.w4-rate*g.b4.w4,w5:w.b4.w5-rate*g.b4.w5,w6:w.b4.w6-rate*g.b4.w6,w7:w.b4.w7-rate*g.b4.w7},b5:Block{w0:w.b5.w0-rate*g.b5.w0,w1:w.b5.w1-rate*g.b5.w1,w2:w.b5.w2-rate*g.b5.w2,w3:w.b5.w3-rate*g.b5.w3,w4:w.b5.w4-rate*g.b5.w4,w5:w.b5.w5-rate*g.b5.w5,w6:w.b5.w6-rate*g.b5.w6,w7:w.b5.w7-rate*g.b5.w7},b6:Block{w0:w.b6.w0-rate*g.b6.w0,w1:w.b6.w1-rate*g.b6.w1,w2:w.b6.w2-rate*g.b6.w2,w3:w.b6.w3-rate*g.b6.w3,w4:w.b6.w4-rate*g.b6.w4,w5:w.b6.w5-rate*g.b6.w5,w6:w.b6.w6-rate*g.b6.w6,w7:w.b6.w7-rate*g.b6.w7},b7:Block{w0:w.b7.w0-rate*g.b7.w0,w1:w.b7.w1-rate*g.b7.w1,w2:w.b7.w2-rate*g.b7.w2,w3:w.b7.w3-rate*g.b7.w3,w4:w.b7.w4-rate*g.b7.w4,w5:w.b7.w5-rate*g.b7.w5,w6:w.b7.w6-rate*g.b7.w6,w7:w.b7.w7-rate*g.b7.w7}};}
fn step(w:Weights,target:f32,rate:f32)->Weights{return derivatives(w,target,4096,true).fold(fn(g)=>update(w,g,rate),fn(e)=>w);}
