module WebProof16;
pub fn accepted_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.filter(fn(x)=>x<seed));}
pub fn calibrated_accepted_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>x*3+k).filter(fn(x)=>x<seed));}
pub fn accepted_calibrated_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.filter(fn(x)=>x<seed).map(fn(x)=>x*3+k));}
pub fn dual_sum_add(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)))+sum(xs.map(fn(x)=>(x+seed)*k));}
pub fn dual_sum_subtract(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)))-sum(xs.map(fn(x)=>(x+seed)*k));}
pub fn dual_sum_weighted(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)))*k+sum(xs.map(fn(x)=>(x+seed)*k))*seed;}
pub fn accepted_total_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.filter(fn(x)=>x>k));}
pub fn calibrated_accepted_total_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)).filter(fn(x)=>x>k));}
pub fn accepted_calibrated_total_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.filter(fn(x)=>x>k).map(fn(x)=>choose(x<seed,seed-x,x-seed)));}
pub fn dual_sum_add_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x>k,x-k,k-x)))+sum(xs.map(fn(x)=>x*x+seed));}
pub fn dual_sum_subtract_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x>k,x-k,k-x)))-sum(xs.map(fn(x)=>x*x+seed));}
pub fn dual_sum_weighted_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x>k,x-k,k-x)))*k+sum(xs.map(fn(x)=>x*x+seed))*seed;}
pub fn abi_calibrated_checksum(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.map(fn(x)=>x*3+k),seed,fn(x)=>fn(a)=>x+a*k);}
pub fn abi_accepted_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.filter(fn(x)=>x<seed));}
pub fn abi_calibrated_accepted_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>x*3+k).filter(fn(x)=>x<seed));}
pub fn abi_distance_total(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)));}
pub fn abi_accepted_checksum(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>x>seed),seed,fn(x)=>fn(a)=>x+a*k);}
pub fn abi_calibrated_accepted_checksum(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.map(fn(x)=>choose(x<seed,x+k,x-k)).filter(fn(x)=>x>seed),seed,fn(x)=>fn(a)=>x+a*k);}
pub fn shared_contribution_add_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>(choose(x<seed,seed-x,x-seed))*k+(choose(x<seed,seed-x,x-seed))*seed));}
pub fn shared_contribution_subtract_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>(choose(x<seed,seed-x,x-seed))*k-(choose(x<seed,seed-x,x-seed))*seed));}
pub fn masked_contribution_add_u32(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x<seed,(choose(x<seed,seed-x,x-seed))*k+(choose(x<seed,seed-x,x-seed))*seed,0)));}
pub fn shared_contribution_add_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>(x*x+seed)*k+(x*x+seed)*seed));}
pub fn shared_contribution_subtract_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>(x*x+seed)*k-(x*x+seed)*seed));}
pub fn masked_contribution_add_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return sum(xs.map(fn(x)=>choose(x>k,(x*x+seed)*k+(x*x+seed)*seed,0)));}
pub fn filtered_arbitrary_fold_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>x<seed),seed,fn(x)=>fn(a)=>choose(x<quot_or(seed,2,0),x+a*k,x-a));}
pub fn mapped_filtered_arbitrary_fold_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.map(fn(x)=>x*3+k).filter(fn(x)=>x<seed),seed,fn(x)=>fn(a)=>choose(x<quot_or(seed,2,0),x+a*k,x-a));}
pub fn filtered_mapped_arbitrary_fold_u32(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>x<seed).map(fn(x)=>x*3+k),seed,fn(x)=>fn(a)=>choose(x<quot_or(seed,2,0),x+a*k,x-a));}
pub fn filtered_arbitrary_fold_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>x>k),seed,fn(x)=>fn(a)=>choose(a<seed,x-a,x+a));}
pub fn mapped_filtered_arbitrary_fold_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.map(fn(x)=>choose(x<seed,seed-x,x-seed)).filter(fn(x)=>x>k),seed,fn(x)=>fn(a)=>choose(a<seed,x-a,x+a));}
pub fn filtered_mapped_arbitrary_fold_u32_heldout(xs:List<u32>,seed:u32,k:u32)->u32{return foldr(xs.filter(fn(x)=>x>k).map(fn(x)=>choose(x<seed,seed-x,x-seed)),seed,fn(x)=>fn(a)=>choose(a<seed,x-a,x+a));}
