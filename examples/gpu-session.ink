module GpuSession;
// Resident GPU session fixtures: element-wise and graph (scan/sort/filter) stages.
fn life(cells: List<u32>, w: u32, h: u32) -> List<u32> {
 return cells.map_indexed(fn(i) => fn(c) => choose((cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(quot_or(i, w, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(i, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(i, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0) + cells.at_or(quot_or(i, w, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0)) == 3, 1, choose((cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(quot_or(i, w, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(rem_or(i, w, 0) + w - 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(i, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(i, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + h - 1, h, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0) + cells.at_or(quot_or(i, w, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0) + cells.at_or(rem_or(quot_or(i, w, 0) + 1, h, 0) * w + rem_or(rem_or(i, w, 0) + 1, w, 0), 0)) == 2, c, 0)));
}
fn prefix(xs: List<u32>) -> List<u32> { return xs.scan(); }
fn shuffle(xs: List<i32>) -> List<i32> { return xs.map(fn(x) => x * 7 + 3).sort(); }
fn positives(xs: List<i32>) -> List<i32> { return xs.filter(fn(x) => x > 0).map(fn(x) => x - 1); }
fn total(xs: List<u32>) -> u32 { return sum(xs); }
fn joined(xs: List<u32>, ys: List<u32>) -> List<u32> { return xs.concat(ys); }
