module whole_target_transition;
import "../../knowledge/libraries/engine_pass_span_graph.ink" as base;
import "../../knowledge/libraries/blocked_measure_sequence.ink" as sequence;
fn direct(e:base.Engine,target:base.Target,on:Bool)->base.Engine{let span=e.spans.at_or(target.slot,base.nil());let changed=base.Span{..span,active:choose(target.insert,on,span.active),deletes:choose(target.insert,span.deletes,choose(on,span.deletes+1,span.deletes-1))};let tree=choose(base.weight(span)==base.weight(changed),e.tree,sequence.set_weight<u32>(e.tree,target.slot,base.weight(changed)));return base.Engine{..e,tree:tree,spans:e.spans.set(target.slot,changed)};}
fn guarded_step(e:base.Engine,target:base.Target,on:Bool)->base.Engine{let span=e.spans.at_or(target.slot,base.nil());let valid=target.slot!=0 && target.slot<e.spans.len() && target.id==span.id && target.length==span.length && target.length!=0 && e.error==0 && (target.insert || on || span.deletes!=0);return choose(valid,base.toggle_step(base.Toggling{engine:e,slot:target.slot,id:target.id,remaining:target.length},target.insert,on).engine,e);}
fn guarded_direct(e:base.Engine,target:base.Target,on:Bool)->base.Engine{let span=e.spans.at_or(target.slot,base.nil());let valid=target.slot!=0 && target.slot<e.spans.len() && target.id==span.id && target.length==span.length && target.length!=0 && e.error==0 && (target.insert || on || span.deletes!=0);return choose(valid,direct(e,target,on),e);}
