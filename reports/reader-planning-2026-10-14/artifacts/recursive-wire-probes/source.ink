module recursive_probe; enum Choice{First,Last,} id Tag; record Node{value:u64,next:Option<Node>,} fn identity(node:Node,pair:Vec2<f32>,exact:Int,choice:Result<Unit,String>)->Node{return node;} fn word(value:u64)->u64{return value;} fn exact(value:Int)->Int{return value;} fn choice(value:Choice)->Choice{return value;} fn key(value:Tag)->Tag{return value;} fn unit(value:Unit)->Unit{return value;}