module filtered_proofs;

fn project(x: u64, scale: u64, bias: u64) -> u64 { return ((x * scale) + bias); }

fn under(x: u64, limit: u64) -> Bool { return (x < limit); }

fn mapped_filter_sum(xs: List<u64>, scale: u64, bias: u64, limit: u64) -> u64 { return sum(xs.map(fn(x) => project(x, scale, bias)).filter(fn(y) => under(y, limit))); }

fn filter_map_sum(xs: List<u64>, scale: u64, bias: u64, limit: u64) -> u64 { return sum(xs.filter(fn(y) => under(y, limit)).map(fn(x) => project(x, scale, bias))); }

fn mapped_filter_count(xs: List<u64>, scale: u64, bias: u64, limit: u64) -> u64 { return count(xs.map(fn(x) => project(x, scale, bias)).filter(fn(y) => under(y, limit))); }

fn constant_filter_sum(xs: List<u64>, scale: u64, bias: u64, limit: u64) -> u64 { return sum(xs.map(fn(ignored) => bias).filter(fn(y) => under(y, limit))); }
