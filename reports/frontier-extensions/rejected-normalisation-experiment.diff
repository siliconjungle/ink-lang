+// Expose a constructor without evaluating its fields. Checked first-order
+// functions are total and effect-free, so substitution and constructor projection
+// may discard unused arguments. This is definitional computation, not a law.
+fn head(t: &Term, c: &Context, budget: &mut Budget, depth: usize) -> LangResult<Term> {
+    budget.step(depth)?;
+    match t {
+        Term::Call { function, arguments } => {
+            let f = match &c.entry(function, true)?.kind {
+                Kind::Function(f) => f,
+                Kind::AbstractFunction(..) => { budget.copy(t)?; return Ok(t.clone()); }
+                _ => return Err("expected function".into()),
+            };
+            for arg in arguments { budget.copy(arg)?; }
+            let mut args=arguments.clone();
+            if let Some(i)=f.recursive {
+                args[i]=head(&args[i],c,budget,depth+1)?;
+                if !matches!(args[i],Term::Construct{..}) {
+                    return Ok(Term::Call{function:function.clone(),arguments:args});
+                }
+            }
+            let bindings=f.params.iter().map(|p|p.0.clone()).zip(args).collect();
+            head(&substitute(&f.body,&bindings,budget,depth+1)?,c,budget,depth+1)
+        }
+        Term::Match { scrutinee, branches } => {
+            let scrutinee=head(scrutinee,c,budget,depth+1)?;
+            if let Term::Construct{constructor,arguments,..}=&scrutinee {
+                let branch=branches.get(*constructor).ok_or("unknown match constructor")?;
+                let bindings=branch.bindings.iter().cloned().zip(arguments.iter().cloned()).collect();
+                head(&substitute(&branch.body,&bindings,budget,depth+1)?,c,budget,depth+1)
+            } else {
+                for branch in branches { budget.copy(&branch.body)?; }
+                Ok(Term::Match{scrutinee:Box::new(scrutinee),branches:branches.clone()})
+            }
+        }
+        Term::If { condition, on_true, on_false } => {
+            let condition=normal(condition,c,budget,depth+1)?;
+            match condition {
+                Term::Bool(true)=>head(on_true,c,budget,depth+1),
+                Term::Bool(false)=>head(on_false,c,budget,depth+1),
+                _=>{budget.copy(on_true)?;budget.copy(on_false)?;Ok(Term::If{condition:Box::new(condition),on_true:on_true.clone(),on_false:on_false.clone()})}
+            }
+        }
+        Term::Binary{..}=>normal(t,c,budget,depth+1),
+        Term::SelfCall(_)=>Err("unbound recursive call in computation".into()),
+        _=>{budget.copy(t)?;Ok(t.clone())}
+    }
+}
